# Copy this file to .env and fill in the values. .env is gitignored: never
# commit it, and never paste real keys into a chat or an issue.
#
#   cp .env.example .env        (macOS, Linux)
#   copy .env.example .env      (Windows)
#
# On Render these go in the dashboard under Environment, not in a file.

# Sign-in accounts for the web UI: email:password, comma separated.
# A password may contain ":" but not "," since that separates accounts.
# These are credentials. Keep them here or in the Render dashboard, never in
# a committed file.
AUDIT_USERS=you@wellows.com:choose-a-long-password

# Optional. A token for scripts and CI that cannot sign in with a form.
# Leave empty if only people use this service. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_API_TOKEN=

# Hosts this kit may audit, comma separated. A host matches itself and its
# subdomains. Every audit is refused while this is empty, so the service
# cannot be used as an open crawler. Audit only domains you own or are
# engaged to audit.
AUDIT_ALLOWED_DOMAINS=

# PageSpeed Insights key for the K checks. Without it the API rate-limits.
# Google Cloud console > APIs > PageSpeed Insights API > Credentials.
PSI_API_KEY=

# Where evidence and reports land. Leave unset to use out/ in this folder.
# On Render the blueprint sets this to the mounted disk at /data/out.
# AUDIT_OUT_DIR=

# How many audits may run at once. Default 1.
# AUDIT_MAX_CONCURRENT=1
